<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Ledo Admin Command Center">
  <title>Ledo · Command Center</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- Icons (Lucide) -->
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <link rel="icon"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' x2='1' y1='0' y2='1'%3E%3Cstop offset='0' stop-color='%236366f1'/%3E%3Cstop offset='1' stop-color='%23ec4899'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='100' height='100' rx='22' fill='url(%23g)'/%3E%3Ctext x='50' y='66' font-family='Outfit,Arial' font-size='58' font-weight='800' text-anchor='middle' fill='white'%3EL%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <!-- Aurora background -->
  <div class="aurora" aria-hidden="true">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="grid-overlay"></div>
  </div>

  <!-- ============ LOGIN VIEW ============ -->
  <div id="login-view" class="view login-view">
    <div class="login-card">
      <div class="login-header">
        <div class="brand-mark">
          <span>L</span>
        </div>
        <h1>Command Center</h1>
        <p>Sign in to manage the Ledo platform</p>
      </div>

      <form id="login-form" class="login-form" novalidate>
        <div class="field">
          <label for="admin-email">Email</label>
          <div class="input-wrap">
            <i data-lucide="mail"></i>
            <input type="email" id="admin-email" placeholder="admin@ledodown.local" autocomplete="username" required>
          </div>
        </div>

        <div class="field">
          <label for="admin-password">Password</label>
          <div class="input-wrap">
            <i data-lucide="lock"></i>
            <input type="password" id="admin-password" placeholder="••••••••" autocomplete="current-password" required>
            <button type="button" class="suffix-btn" data-toggle-pwd="admin-password" aria-label="Show password">
              <i data-lucide="eye"></i>
            </button>
          </div>
        </div>

        <div class="login-options">
          <label class="check">
            <input type="checkbox" id="remember-me">
            <span class="check-box"></span>
            <span>Remember me</span>
          </label>
        </div>

        <button type="submit" id="btn-login" class="btn-primary">
          <span>Sign in</span>
          <i data-lucide="arrow-right"></i>
        </button>

        <div id="login-error" class="login-error"></div>
      </form>
    </div>
    <div class="login-bg-text">LEDO</div>
  </div>

  <!-- ============ DASHBOARD VIEW ============ -->
  <div id="dashboard-view" class="view dashboard-view" hidden>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-head">
        <div class="brand">
          <div class="brand-mark small"><span>L</span></div>
          <div class="brand-text">
            <div class="brand-name">Ledo</div>
            <div class="brand-sub">Command Center</div>
          </div>
        </div>
        <button class="icon-btn" id="collapse-sidebar" title="Collapse sidebar" aria-label="Collapse sidebar">
          <i data-lucide="panel-left-close"></i>
        </button>
      </div>

      <nav class="nav" aria-label="Primary">
        <div class="nav-section">
          <div class="nav-label">Workspace</div>
          <a href="#overview" class="nav-item active" data-route="overview">
            <i data-lucide="layout-dashboard"></i>
            <span class="nav-text">Overview</span>
          </a>
          <a href="#tickets" class="nav-item" data-route="tickets">
            <i data-lucide="ticket"></i>
            <span class="nav-text">Tickets</span>
            <span class="nav-badge" id="tickets-count">0</span>
          </a>
          <a href="#users" class="nav-item" data-route="users">
            <i data-lucide="users"></i>
            <span class="nav-text">Users</span>
          </a>
          <a href="#crashes" class="nav-item" data-route="crashes">
            <i data-lucide="bug"></i>
            <span class="nav-text">Crash Reports</span>
          </a>
          <a href="#announcements" class="nav-item" data-route="announcements">
            <i data-lucide="megaphone"></i>
            <span class="nav-text">Announcements</span>
          </a>
          <a href="#updates" class="nav-item" data-route="updates">
            <i data-lucide="rocket"></i>
            <span class="nav-text">App Releases</span>
          </a>
        </div>
        <div class="nav-section">
          <div class="nav-label">Insights</div>
          <a href="#analytics" class="nav-item" data-route="analytics">
            <i data-lucide="bar-chart-3"></i>
            <span class="nav-text">Analytics</span>
          </a>
        </div>
        <div class="nav-section">
          <div class="nav-label">You</div>
          <a href="#account" class="nav-item" data-route="account">
            <i data-lucide="user-circle-2"></i>
            <span class="nav-text">My Account</span>
          </a>
          <a href="#settings" class="nav-item" data-route="settings">
            <i data-lucide="settings-2"></i>
            <span class="nav-text">Settings</span>
          </a>
        </div>
      </nav>

      <div class="sidebar-foot">
        <div class="admin-card">
          <div class="admin-avatar" id="admin-avatar">A</div>
          <div class="admin-info">
            <div class="admin-name" id="admin-name">Admin</div>
            <div class="admin-role" id="admin-role">Administrator</div>
          </div>
          <button class="icon-btn" id="btn-logout" title="Sign out" aria-label="Sign out">
            <i data-lucide="log-out"></i>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main -->
    <main class="main">
      <!-- Topbar -->
      <header class="topbar">
        <div class="topbar-left">
          <button class="icon-btn mobile-only" id="mobile-menu" aria-label="Open menu">
            <i data-lucide="menu"></i>
          </button>
          <div>
            <div class="page-title" id="page-title">Overview</div>
            <div class="page-sub" id="page-sub">Welcome back — here's what's happening today</div>
          </div>
        </div>
        <div class="topbar-right">
          <div class="search-box">
            <i data-lucide="search"></i>
            <input type="text" id="global-search" placeholder="Search tickets, users..." />
            <kbd>⌘K</kbd>
          </div>
          <button class="icon-btn" id="theme-toggle" title="Toggle theme" aria-label="Toggle theme">
            <i data-lucide="moon"></i>
          </button>
          <button class="icon-btn notif-btn" id="notif-btn" title="Notifications" aria-label="Notifications">
            <i data-lucide="bell"></i>
            <span class="dot" id="notif-dot" hidden></span>
          </button>
          <div class="health-dropdown-wrapper" style="position:relative;">
            <button class="status-pill" id="health-monitor-btn" title="System Health">
              <span class="status-dot" id="health-global-dot"></span>
              <span id="health-global-text">Checking...</span>
            </button>
            <div id="health-dropdown" class="health-dropdown" hidden
              style="position:absolute; top:100%; right:0; margin-top:8px; background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:16px; width:280px; box-shadow:0 10px 30px rgba(0,0,0,0.2); z-index:100;">
              <div
                style="font-weight:600; font-size:14px; margin-bottom:12px; color:var(--text); border-bottom:1px solid var(--border); padding-bottom:8px;">
                System Health</div>
              <div style="display:flex; flex-direction:column; gap:10px; font-size:13px;">
                <div class="health-item" style="display:flex; justify-content:space-between; align-items:center;">
                  <span style="color:var(--text-muted)">Firebase Auth</span>
                  <span id="health-auth"><span class="dot" style="background:#fbbf24"></span> Checking</span>
                </div>
                <div class="health-item" style="display:flex; justify-content:space-between; align-items:center;">
                  <span style="color:var(--text-muted)">Firestore</span>
                  <span id="health-firestore"><span class="dot" style="background:#fbbf24"></span> Checking</span>
                </div>
                <div class="health-item" style="display:flex; justify-content:space-between; align-items:center;">
                  <span style="color:var(--text-muted)">Announcements</span>
                  <span id="health-announcements"><span class="dot" style="background:#fbbf24"></span> Checking</span>
                </div>
                <div class="health-item" style="display:flex; justify-content:space-between; align-items:center;">
                  <span style="color:var(--text-muted)">App Updates</span>
                  <span id="health-updates"><span class="dot" style="background:#fbbf24"></span> Checking</span>
                </div>
                <div class="health-item" style="display:flex; justify-content:space-between; align-items:center;">
                  <span style="color:var(--text-muted)">Users DB</span>
                  <span id="health-users"><span class="dot" style="background:#fbbf24"></span> Checking</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- Content -->
      <section class="content">
        <!-- ===== OVERVIEW ===== -->
        <div class="route active" data-route="overview">
          <div class="kpi-grid">
            <div class="kpi-card kpi-tickets">
              <div class="kpi-head">
                <div class="kpi-icon"><i data-lucide="ticket"></i></div>
                <div class="kpi-trend" data-kpi-trend="total">—</div>
              </div>
              <div class="kpi-value" data-kpi="total">0</div>
              <div class="kpi-label">Total Tickets</div>
              <div class="kpi-spark" data-spark="total"></div>
            </div>

            <div class="kpi-card kpi-open">
              <div class="kpi-head">
                <div class="kpi-icon"><i data-lucide="circle-dot"></i></div>
                <div class="kpi-trend" data-kpi-trend="open">—</div>
              </div>
              <div class="kpi-value" data-kpi="open">0</div>
              <div class="kpi-label">Open</div>
              <div class="kpi-spark" data-spark="open"></div>
            </div>

            <div class="kpi-card kpi-progress">
              <div class="kpi-head">
                <div class="kpi-icon"><i data-lucide="loader"></i></div>
                <div class="kpi-trend" data-kpi-trend="progress">—</div>
              </div>
              <div class="kpi-value" data-kpi="progress">0</div>
              <div class="kpi-label">In Progress</div>
              <div class="kpi-spark" data-spark="progress"></div>
            </div>

            <div class="kpi-card kpi-resolved">
              <div class="kpi-head">
                <div class="kpi-icon"><i data-lucide="check-circle-2"></i></div>
                <div class="kpi-trend" data-kpi-trend="resolved">—</div>
              </div>
              <div class="kpi-value" data-kpi="resolved">0</div>
              <div class="kpi-label">Resolved</div>
              <div class="kpi-spark" data-spark="resolved"></div>
            </div>
          </div>

          <div class="grid-2">
            <div class="card chart-card">
              <div class="card-head">
                <div>
                  <h3>Tickets Timeline</h3>
                  <div class="card-sub">Last 14 days</div>
                </div>
                <div class="seg" id="range-seg">
                  <button class="seg-btn" data-range="7">7D</button>
                  <button class="seg-btn active" data-range="14">14D</button>
                  <button class="seg-btn" data-range="30">30D</button>
                </div>
              </div>
              <div class="chart-wrap"><canvas id="chart-timeline"></canvas></div>
            </div>

            <div class="card chart-card">
              <div class="card-head">
                <div>
                  <h3>By Status</h3>
                  <div class="card-sub">Distribution</div>
                </div>
              </div>
              <div class="chart-wrap"><canvas id="chart-status"></canvas></div>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <div>
                <h3>Recent Activity</h3>
                <div class="card-sub">Latest tickets from users</div>
              </div>
              <a href="#tickets" class="link" data-route="tickets">View all <i data-lucide="arrow-right"></i></a>
            </div>
            <div id="recent-activity" class="activity-list">
              <div class="skeleton-row"></div>
              <div class="skeleton-row"></div>
              <div class="skeleton-row"></div>
            </div>
          </div>
        </div>

        <!-- ===== TICKETS ===== -->
        <div class="route" data-route="tickets" hidden>
          <div class="toolbar">
            <div class="filters" id="status-filters">
              <button class="chip active" data-filter="all">
                All <span class="chip-count" data-count="all">0</span>
              </button>
              <button class="chip" data-filter="open">
                <span class="dot dot-open"></span> Open <span class="chip-count" data-count="open">0</span>
              </button>
              <button class="chip" data-filter="in_progress">
                <span class="dot dot-progress"></span> In Progress <span class="chip-count"
                  data-count="progress">0</span>
              </button>
              <button class="chip" data-filter="resolved">
                <span class="dot dot-resolved"></span> Resolved <span class="chip-count" data-count="resolved">0</span>
              </button>
            </div>
            <div class="search-box small">
              <i data-lucide="search"></i>
              <input type="text" id="ticket-search" placeholder="Search by subject, email, message..." />
            </div>
          </div>

          <div class="card no-pad">
            <div class="table-wrap">
              <table class="data-table" id="tickets-table">
                <thead>
                  <tr>
                    <th>Status</th>
                    <th>Subject</th>
                    <th>User</th>
                    <th>Created</th>
                    <th class="t-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="tickets-tbody">
                  <tr>
                    <td colspan="5" class="empty">Loading tickets…</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="table-foot">
              <div class="muted" id="tickets-summary">—</div>
            </div>
          </div>
        </div>

        <!-- ===== USERS ===== -->
        <div class="route" data-route="users" hidden>
          <div class="toolbar">
            <div class="filters">
              <button class="chip active" data-usersort="tickets">Most tickets</button>
              <button class="chip" data-usersort="recent">Recent activity</button>
              <button class="chip" data-usersort="alpha">A → Z</button>
            </div>
            <div class="search-box small">
              <i data-lucide="search"></i>
              <input type="text" id="user-search" placeholder="Search users..." />
            </div>
          </div>
          <div class="users-grid" id="users-grid">
            <div class="user-skeleton"></div>
            <div class="user-skeleton"></div>
            <div class="user-skeleton"></div>
          </div>
        </div>

        <!-- ===== CRASHES ===== -->
        <div class="route" data-route="crashes" hidden>
          <div class="card no-pad">
            <div class="table-wrap">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Crash Signature</th>
                    <th style="text-align:center;">Occurrences</th>
                    <th style="text-align:center;">Devices</th>
                    <th>First Seen</th>
                    <th>Last Seen</th>
                  </tr>
                </thead>
                <tbody id="crashes-tbody">
                  <tr>
                    <td colspan="5" class="empty">Loading crash reports…</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ===== ANNOUNCEMENTS ===== -->
        <div class="route" data-route="announcements" hidden>
          <div class="grid-2" style="grid-template-columns: 1fr 1.2fr; gap: 24px; align-items: flex-start;">
            <!-- Create Announcement Card -->
            <div class="card">
              <div class="card-head">
                <div>
                  <h3 style="display:flex;align-items:center;gap:8px;">
                    <i data-lucide="megaphone" style="color:var(--accent,#3b82f6)"></i> Send New Announcement
                  </h3>
                  <div class="card-sub">Shows as a popup to all desktop users when opening the app</div>
                </div>
              </div>
              <form id="ann-form" style="display:flex;flex-direction:column;gap:16px;margin-top:16px;">
                <div class="form-group">
                  <label for="ann-title">Title / Headline</label>
                  <input type="text" id="ann-title" class="input" placeholder="e.g. مرحباً بكم في الإصدار الجديد!" />
                </div>
                <div class="form-group">
                  <label for="ann-body">Message Body</label>
                  <textarea id="ann-body" class="input" rows="4" placeholder="Enter message text for users..."
                    style="resize:vertical;"></textarea>
                </div>
                <div class="grid-2" style="gap:12px;">
                  <div class="form-group">
                    <label for="ann-type">Type</label>
                    <select id="ann-type" class="input">
                      <option value="info">Information (إشعار)</option>
                      <option value="warning">Warning (تنبيه)</option>
                      <option value="update">Update Notice (تحديث)</option>
                      <option value="alert">Urgent Alert (عاجل)</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="ann-priority">Priority</label>
                    <select id="ann-priority" class="input">
                      <option value="normal">Normal</option>
                      <option value="high">High (Shows First)</option>
                    </select>
                  </div>
                </div>
                <div class="grid-2" style="gap:12px;">
                  <div class="form-group">
                    <label for="ann-action-url">Action URL (Optional)</label>
                    <input type="text" id="ann-action-url" class="input" placeholder="https://..." />
                  </div>
                  <div class="form-group">
                    <label for="ann-action-label">Button Label</label>
                    <input type="text" id="ann-action-label" class="input" placeholder="e.g. عرض التفاصيل" />
                  </div>
                </div>
                <div class="form-group">
                  <label for="ann-min-version">Min App Version (Target)</label>
                  <input type="text" id="ann-min-version" class="input" placeholder="e.g. 3.9.0" />
                </div>
                <div class="grid-2" style="gap:12px;">
                  <div class="form-group">
                    <label for="ann-schedule-start">Schedule Start (Optional)</label>
                    <input type="datetime-local" id="ann-schedule-start" class="input" />
                  </div>
                  <div class="form-group">
                    <label for="ann-schedule-end">Schedule End (Optional)</label>
                    <input type="datetime-local" id="ann-schedule-end" class="input" />
                  </div>
                </div>
                <div class="form-group">
                  <label for="ann-status">Status</label>
                  <select id="ann-status" class="input">
                    <option value="published">Published (Active)</option>
                    <option value="draft">Draft (Hidden)</option>
                    <option value="disabled">Disabled</option>
                  </select>
                </div>
                <input type="hidden" id="ann-id" value="" />
                <div style="display:flex; gap:10px; margin-top:4px;">
                  <button type="submit" class="btn btn-primary" id="btn-ann-submit">
                    <i data-lucide="send"></i> <span>Publish Announcement</span>
                  </button>
                  <button type="button" class="btn btn-ghost" id="btn-ann-cancel" hidden>
                    Cancel
                  </button>
                </div>
              </form>
            </div>

            <!-- Active Announcements List -->
            <div class="card">
              <div class="card-head">
                <div>
                  <h3>Active Announcements</h3>
                  <div class="card-sub">Currently active messages delivered to desktop apps</div>
                </div>
              </div>
              <div id="announcements-list" style="display:flex;flex-direction:column;gap:12px;margin-top:16px;">
                <div class="empty">Loading announcements…</div>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== APP RELEASES & MEDIAFIRE UPDATES ===== -->
        <div class="route" data-route="updates" hidden>
          <div class="grid-2" style="grid-template-columns: 1fr 1fr; gap: 24px; align-items: flex-start;">
            <!-- Publish Update Card -->
            <div class="card">
              <div class="card-head">
                <div>
                  <h3 style="display:flex;align-items:center;gap:8px;">
                    <i data-lucide="rocket" style="color:#10b981"></i> Release New Version
                  </h3>
                  <div class="card-sub">Publish a new installer link (MediaFire, Google Drive, Direct)</div>
                </div>
              </div>
              <form id="update-form" style="display:flex;flex-direction:column;gap:16px;margin-top:16px;">
                <div class="form-group">
                  <label for="update-version">Version Number</label>
                  <input type="text" id="update-version" class="input" placeholder="e.g. 4.0.0" />
                </div>
                <div class="form-group">
                  <label for="update-download-url">MediaFire Download Link</label>
                  <input type="text" id="update-download-url" class="input" placeholder="https://www.mediafire.com/file/..." />
                </div>
                <div class="form-group">
                  <label for="update-changelog-input">Changelog / What's New</label>
                  <textarea id="update-changelog-input" class="input" rows="5" placeholder="- ميزات جديدة&#10;- إصلاح أخطاء التحميل&#10;- تحسين الأداء" style="resize:vertical;"></textarea>
                </div>
                <div class="form-group" style="padding:4px 0;">
                  <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                    <input type="checkbox" id="update-required" style="width:18px;height:18px;cursor:pointer;" />
                    <span style="font-weight:600;">Force Update (\u0625\u0644\u0632\u0627\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0628\u0627\u0644\u062a\u062d\u062f\u064a\u062b)</span>
                  </label>
                </div>
                <div class="form-group">
                  <label for="update-min-version">Minimum Supported Version (Optional)</label>
                  <input type="text" id="update-min-version" class="input" placeholder="e.g. 3.9.0 (Blocks older versions)" />
                </div>
                <div class="grid-2" style="gap:12px;">
                  <div class="form-group">
                    <label for="update-channel">Release Channel</label>
                    <select id="update-channel" class="input">
                      <option value="stable">Stable</option>
                      <option value="beta">Beta</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="update-sha256">SHA-256 (Optional)</label>
                    <input type="text" id="update-sha256" class="input" placeholder="64-character installer hash" maxlength="64" />
                  </div>
                </div>
                <button type="submit" class="btn btn-primary" style="background:#10b981;border-color:#059669;margin-top:8px;">
                  <i data-lucide="upload-cloud"></i> Save &amp; Publish Update
                </button>
              </form>
            </div>

            <div style="display:flex; flex-direction:column; gap:24px;">
              <!-- Current Release Live Preview -->
              <div class="card">
                <div class="card-head">
                  <div>
                    <h3>Current Live Release</h3>
                    <div class="card-sub">What users currently see when checking for updates</div>
                  </div>
                </div>
                <div id="live-update-preview" style="margin-top:16px;">
                  <div class="empty">Loading release info\u2026</div>
                </div>
              </div>

              <!-- Release History -->
              <div class="card">
                <div class="card-head">
                  <div>
                    <h3>Release History</h3>
                    <div class="card-sub">Past versions and rollback options</div>
                  </div>
                </div>
                <div id="release-history-list" style="display:flex;flex-direction:column;gap:12px;margin-top:16px;max-height:400px;overflow-y:auto;padding-right:8px;">
                  <div class="empty">Loading history\u2026</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card" style="margin-top:20px;">
            <div class="card-head">
              <div>
                <h3 style="display:flex;align-items:center;gap:8px;"><i data-lucide="link-2" style="color:#60a5fa"></i> Public App Links</h3>
                <div class="card-sub">Links displayed in the desktop app's About page</div>
              </div>
            </div>
            <form id="public-links-form" class="grid-2" style="gap:14px;margin-top:16px;">
              <div class="form-group"><label for="public-website-url">Official website</label><input type="url" id="public-website-url" class="input" placeholder="https://example.com" /></div>
              <div class="form-group"><label for="public-support-url">Support page</label><input type="url" id="public-support-url" class="input" placeholder="https://example.com/support" /></div>
              <div class="form-group"><label for="public-privacy-url">Privacy policy</label><input type="url" id="public-privacy-url" class="input" placeholder="https://example.com/privacy" /></div>
              <div class="form-group"><label for="public-terms-url">Terms of use</label><input type="url" id="public-terms-url" class="input" placeholder="https://example.com/terms" /></div>
              <div style="grid-column:1/-1;"><button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Save Public Links</button></div>
            </form>
          </div>
        </div>

        <!-- ===== ANALYTICS ===== -->
        <div class="route" data-route="analytics" hidden>
          <div class="grid-2">
            <div class="card chart-card">
              <div class="card-head">
                <div>
                  <h3>Daily Volume</h3>
                  <div class="card-sub">Last 30 days</div>
                </div>
              </div>
              <div class="chart-wrap"><canvas id="chart-daily"></canvas></div>
            </div>
            <div class="card chart-card">
              <div class="card-head">
                <div>
                  <h3>Top Subjects</h3>
                  <div class="card-sub">Most reported categories</div>
                </div>
              </div>
              <div id="top-subjects" class="bar-list"></div>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <h3>Performance</h3>
            </div>
            <div class="perf-grid">
              <div class="perf-item">
                <div class="perf-label">Avg. response time</div>
                <div class="perf-value" id="perf-response">—</div>
              </div>
              <div class="perf-item">
                <div class="perf-label">Resolution rate</div>
                <div class="perf-value" id="perf-resolve">—</div>
              </div>
              <div class="perf-item">
                <div class="perf-label">Active users</div>
                <div class="perf-value" id="perf-users">—</div>
              </div>
              <div class="perf-item">
                <div class="perf-label">Tickets today</div>
                <div class="perf-value" id="perf-today">—</div>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== MY ACCOUNT ===== -->
        <div class="route" data-route="account" hidden>
    <!-- Profile Hero -->
    <div class="acct-hero">
      <div class="acct-cover">
        <div class="acct-cover-actions">
          <button class="acct-cover-btn" type="button"><i data-lucide="image"></i> Change cover</button>
          <button class="acct-cover-btn" type="button"><i data-lucide="share-2"></i> Share</button>
        </div>
      </div>
      <div class="acct-body">
        <div class="acct-avatar-wrap">
          <div class="acct-avatar" id="account-avatar">A</div>
          <button class="avatar-upload-btn" id="avatar-upload-btn" title="Change avatar" type="button">
            <i data-lucide="camera"></i>
          </button>
        </div>
        <div class="acct-info">
          <div class="acct-name-row">
            <h2 id="account-display-name">Admin</h2>
            <span class="acct-pill verified" id="account-verified">
              <i data-lucide="badge-check"></i> Verified
            </span>
            <span class="acct-pill pro"><i data-lucide="crown"></i> Pro</span>
            <span class="acct-pill online"><span class="dot"></span> Online</span>
          </div>
          <div class="acct-handle" id="account-email-display">—</div>
          <div class="acct-meta">
            <span class="acct-meta-item"><i data-lucide="shield"></i> Super Admin</span>
            <span class="acct-meta-item"><i data-lucide="calendar"></i> Joined <span id="account-joined">—</span></span>
            <span class="acct-meta-item"><i data-lucide="globe"></i> <span id="account-location">Earth</span></span>
          </div>
        </div>
        <div class="acct-stats">
          <div class="acct-stat">
            <div class="acct-stat-value" data-personal-stat="handled">0</div>
            <div class="acct-stat-label">Handled</div>
          </div>
          <div class="acct-stat">
            <div class="acct-stat-value" data-personal-stat="resolved">0</div>
            <div class="acct-stat-label">Resolved</div>
          </div>
          <div class="acct-stat">
            <div class="acct-stat-value" data-personal-stat="rating">—</div>
            <div class="acct-stat-label">Rating</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs (horizontal pill row) -->
    <div class="acct-tabs" role="tablist">
      <button class="acct-tab active" data-account-tab="profile" role="tab">
        <i data-lucide="user"></i> Profile
      </button>
      <button class="acct-tab" data-account-tab="security" role="tab">
        <i data-lucide="shield"></i> Security <span class="tab-badge">!</span>
      </button>
      <button class="acct-tab" data-account-tab="notifications" role="tab">
        <i data-lucide="bell"></i> Notifications
      </button>
      <button class="acct-tab" data-account-tab="activity" role="tab">
        <i data-lucide="activity"></i> Activity
      </button>
      <button class="acct-tab" data-account-tab="integrations" role="tab">
        <i data-lucide="plug-2"></i> Integrations
      </button>
      <button class="acct-tab danger" data-account-tab="danger" role="tab">
        <i data-lucide="alert-octagon"></i> Danger Zone
      </button>
    </div>

    <!-- Panes -->
    <div class="account-panes">
      <!-- ===== PROFILE TAB ===== -->
      <div class="account-pane active" data-account-pane="profile">
        <div class="acct-grid">
          <div class="acct-form-stack">
            <!-- Public Profile -->
            <div class="acct-form-card">
              <div class="acct-form-head">
                <div>
                  <h3>Public Profile</h3>
                  <p>How others see you across the platform</p>
                </div>
                <span class="save-indicator" id="save-indicator">
                  <i data-lucide="check-circle-2"></i> All changes saved
                </span>
              </div>
              <div class="acct-form-body">
                <div class="acct-section">
                  <div class="acct-section-title"><i data-lucide="user"></i> Identity</div>
                  <div class="acct-row">
                    <div class="acct-field">
                      <label>Display name</label>
                      <div class="acct-input">
                        <i data-lucide="user"></i>
                        <input type="text" id="profile-name" placeholder="Your name" />
                      </div>
                    </div>
                    <div class="acct-field">
                      <label>Username</label>
                      <div class="acct-input">
                        <span class="prefix">@</span>
                        <input type="text" id="profile-username" placeholder="username" />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="acct-section">
                  <div class="acct-section-title"><i data-lucide="contact"></i> Contact</div>
                  <div class="acct-row">
                    <div class="acct-field full">
                      <label>Email</label>
                      <div class="acct-input readonly">
                        <i data-lucide="mail"></i>
                        <input type="email" id="profile-email" readonly />
                        <span class="verified-pill" id="email-verified-pill">
                          <i data-lucide="check"></i> Verified
                        </span>
                      </div>
                    </div>
                    <div class="acct-field full">
                      <label>Phone</label>
                      <div class="acct-input">
                        <i data-lucide="phone"></i>
                        <input type="tel" id="profile-phone" placeholder="+20 100 000 0000" />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="acct-section">
                  <div class="acct-section-title"><i data-lucide="map"></i> Location & Web</div>
                  <div class="acct-row">
                    <div class="acct-field">
                      <label>Location</label>
                      <div class="acct-input">
                        <i data-lucide="map-pin"></i>
                        <input type="text" id="profile-location" placeholder="City, Country" />
                      </div>
                    </div>
                    <div class="acct-field">
                      <label>Website</label>
                      <div class="acct-input">
                        <i data-lucide="link"></i>
                        <input type="url" id="profile-website" placeholder="https://yoursite.com" />
                      </div>
                    </div>
                  </div>
                  <div class="acct-row" style="margin-top:12px">
                    <div class="acct-field full">
                      <label>Timezone</label>
                      <div class="acct-input">
                        <i data-lucide="clock"></i>
                        <select id="profile-timezone">
                          <option value="Africa/Cairo">Africa/Cairo (GMT+2)</option>
                          <option value="Europe/London">Europe/London (GMT+0)</option>
                          <option value="America/New_York">America/New_York (GMT-5)</option>
                          <option value="America/Los_Angeles">America/Los_Angeles (GMT-8)</option>
                          <option value="Asia/Dubai">Asia/Dubai (GMT+4)</option>
                          <option value="Asia/Riyadh">Asia/Riyadh (GMT+3)</option>
                          <option value="Asia/Tokyo">Asia/Tokyo (GMT+9)</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="acct-section">
                  <div class="acct-section-title"><i data-lucide="align-left"></i> About you</div>
                  <div class="acct-field full">
                    <div class="acct-input" style="align-items:flex-start">
                      <i data-lucide="message-square" style="margin-top:2px"></i>
                      <textarea id="profile-bio" rows="3" placeholder="Tell us a bit about yourself…"
                        maxlength="280"></textarea>
                    </div>
                    <div class="acct-hint"><span id="bio-count">0</span>/280</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right sidebar: live preview + social -->
          <div class="acct-side">
            <div class="acct-preview">
              <div class="acct-preview-cover"></div>
              <div class="acct-preview-avatar" id="acct-preview-avatar">A</div>
              <div class="acct-preview-name" id="acct-preview-name">Admin</div>
              <div class="acct-preview-handle" id="acct-preview-handle">@admin</div>
              <div class="acct-preview-bio" id="acct-preview-bio">Tell others a bit about yourself…</div>
              <div class="acct-preview-stats">
                <div class="acct-preview-stat">
                  <div class="acct-preview-stat-n" id="acct-preview-handled">0</div>
                  <div class="acct-preview-stat-l">Handled</div>
                </div>
                <div class="acct-preview-stat">
                  <div class="acct-preview-stat-n" id="acct-preview-resolved">0</div>
                  <div class="acct-preview-stat-l">Resolved</div>
                </div>
                <div class="acct-preview-stat">
                  <div class="acct-preview-stat-n" id="acct-preview-rating">—</div>
                  <div class="acct-preview-stat-l">Rating</div>
                </div>
              </div>
              <div class="acct-completeness">
                <div class="acct-completeness-head">
                  <span class="acct-completeness-label">Profile completeness</span>
                  <span class="acct-completeness-value" id="acct-completeness-value">0%</span>
                </div>
                <div class="acct-progress">
                  <div class="acct-progress-fill" id="acct-progress-fill"></div>
                </div>
              </div>
              <button class="acct-btn" type="button" style="width:100%;justify-content:center">
                <i data-lucide="external-link"></i> View public profile
              </button>
            </div>

            <div class="acct-form-card">
              <div class="acct-form-head" style="background:transparent;padding:18px 20px">
                <div>
                  <h3 style="font-size:14px">Social Links</h3>
                  <p>Connect your accounts</p>
                </div>
              </div>
              <div class="acct-form-body" style="padding:16px 20px">
                <div class="acct-social-grid">
                  <div class="acct-social">
                    <div class="ic" style="background:linear-gradient(135deg,#333,#000)"><svg
                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path
                          d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                        <path d="M9 18c-4.51 2-5-2-7-2" />
                      </svg></div>
                    <input type="text" id="social-github" placeholder="github.com/username" />
                  </div>
                  <div class="acct-social">
                    <div class="ic" style="background:linear-gradient(135deg,#1da1f2,#0d8ddc)"><svg
                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path
                          d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />
                      </svg></div>
                    <input type="text" id="social-twitter" placeholder="@handle" />
                  </div>
                  <div class="acct-social">
                    <div class="ic" style="background:linear-gradient(135deg,#5865f2,#404eed)"><i
                        data-lucide="message-circle"></i></div>
                    <input type="text" id="social-discord" placeholder="username#0000" />
                  </div>
                  <div class="acct-social">
                    <div class="ic" style="background:linear-gradient(135deg,#e4405f,#fcaf45)"><svg
                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                      </svg></div>
                    <input type="text" id="social-instagram" placeholder="@handle" />
                  </div>
                  <div class="acct-social">
                    <div class="ic" style="background:linear-gradient(135deg,#0a66c2,#004182)"><svg
                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                        <rect width="4" height="12" x="2" y="9" />
                        <circle cx="4" cy="4" r="2" />
                      </svg></div>
                    <input type="text" id="social-linkedin" placeholder="in/username" />
                  </div>
                  <div class="acct-social">
                    <div class="ic" style="background:linear-gradient(135deg,#ff0000,#cc0000)"><svg
                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path
                          d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
                        <path d="m10 15 5-3-5-3z" />
                      </svg></div>
                    <input type="text" id="social-youtube" placeholder="@channel" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== SECURITY TAB ===== -->
      <div class="account-pane" data-account-pane="security" hidden>
        <!-- Password -->
        <div class="card">
          <div class="card-head">
            <div>
              <h3>Password</h3>
              <div class="card-sub">Last changed <span id="pwd-last-changed">never</span></div>
            </div>
          </div>
          <form class="form-grid" onsubmit="return false;">
            <div class="form-field full">
              <label>Current password</label>
              <div class="input-wrap">
                <i data-lucide="lock"></i>
                <input type="password" id="pwd-current" autocomplete="current-password"
                  placeholder="Enter current password" />
                <button type="button" class="suffix-btn" data-toggle-pwd="pwd-current">
                  <i data-lucide="eye"></i>
                </button>
              </div>
            </div>
            <div class="form-field">
              <label>New password</label>
              <div class="input-wrap">
                <i data-lucide="key"></i>
                <input type="password" id="pwd-new" autocomplete="new-password"
                  placeholder="Choose a strong password" />
                <button type="button" class="suffix-btn" data-toggle-pwd="pwd-new">
                  <i data-lucide="eye"></i>
                </button>
              </div>
              <div class="pwd-strength" id="pwd-strength">
                <div class="pwd-strength-bar">
                  <div class="pwd-strength-fill" id="pwd-strength-fill"></div>
                </div>
                <div class="pwd-strength-label" id="pwd-strength-label">Enter a password</div>
              </div>
            </div>
            <div class="form-field">
              <label>Confirm new password</label>
              <div class="input-wrap">
                <i data-lucide="key"></i>
                <input type="password" id="pwd-confirm" autocomplete="new-password" placeholder="Repeat new password" />
                <button type="button" class="suffix-btn" data-toggle-pwd="pwd-confirm">
                  <i data-lucide="eye"></i>
                </button>
              </div>
            </div>
          </form>
          <div class="form-actions">
            <button class="btn-primary" id="btn-change-password">
              <i data-lucide="shield-check"></i><span>Update password</span>
            </button>
          </div>
        </div>

        <!-- 2FA -->
        <div class="card">
          <div class="card-head">
            <div>
              <h3>Two-Factor Authentication</h3>
              <div class="card-sub">Add an extra layer of security to your account</div>
            </div>
            <span class="status-pill sm status-off" id="tfa-status">
              <span class="dot"></span> Disabled
            </span>
          </div>
          <div class="tfa-options">
            <div class="tfa-option">
              <div class="tfa-icon"><i data-lucide="smartphone"></i></div>
              <div class="tfa-info">
                <div class="tfa-name">Authenticator App</div>
                <div class="tfa-desc">Use Google Authenticator, Authy, or 1Password</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tfa-app">
                <span class="switch-slider"></span>
              </label>
            </div>
            <div class="tfa-option">
              <div class="tfa-icon"><i data-lucide="message-square"></i></div>
              <div class="tfa-info">
                <div class="tfa-name">SMS Verification</div>
                <div class="tfa-desc">Receive codes via text message</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tfa-sms">
                <span class="switch-slider"></span>
              </label>
            </div>
            <div class="tfa-option">
              <div class="tfa-icon"><i data-lucide="mail"></i></div>
              <div class="tfa-info">
                <div class="tfa-name">Email Verification</div>
                <div class="tfa-desc">Receive codes via email</div>
              </div>
              <label class="switch">
                <input type="checkbox" id="tfa-email" checked>
                <span class="switch-slider"></span>
              </label>
            </div>
          </div>
        </div>

        <!-- Active Sessions -->
        <div class="card">
          <div class="card-head">
            <div>
              <h3>Active Sessions</h3>
              <div class="card-sub">Devices currently logged in to your account</div>
            </div>
            <button class="btn-danger sm" id="btn-signout-all">
              <i data-lucide="log-out"></i><span>Sign out all</span>
            </button>
          </div>
          <div class="sessions-list" id="sessions-list">
            <div class="session-item current">
              <div class="session-icon"><i data-lucide="monitor"></i></div>
              <div class="session-info">
                <div class="session-name">This device</div>
                <div class="session-meta">
                  <span><i data-lucide="globe"></i> <span id="sess-browser">—</span></span>
                  <span><i data-lucide="map-pin"></i> <span id="sess-location">—</span></span>
                  <span class="session-current">● Active now</span>
                </div>
              </div>
              <span class="session-pill">Current</span>
            </div>
          </div>
        </div>

        <!-- API Tokens -->
        <div class="card">
          <div class="card-head">
            <div>
              <h3>API Tokens</h3>
              <div class="card-sub">Personal access tokens for the Ledo API</div>
            </div>
            <button class="btn-ghost" id="btn-new-token">
              <i data-lucide="plus"></i> Generate new
            </button>
          </div>
          <div class="tokens-list" id="tokens-list">
            <div class="token-item">
              <div class="token-icon"><i data-lucide="key"></i></div>
              <div class="token-info">
                <div class="token-name">Dashboard CLI</div>
                <div class="token-meta">
                  <span class="token-mono">ledo_pat_************************a8f2</span>
                  <span>Created 12 days ago</span>
                  <span>Last used 2h ago</span>
                </div>
              </div>
              <button class="row-btn" title="Revoke">
                <i data-lucide="trash-2"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== NOTIFICATIONS TAB ===== -->
      <div class="account-pane" data-account-pane="notifications" hidden>
        <div class="card">
          <div class="card-head">
            <div>
              <h3>Channels</h3>
              <div class="card-sub">Where you want to be notified</div>
            </div>
          </div>
          <div class="notif-matrix">
            <div class="notif-matrix-head">
              <div></div>
              <div class="matrix-col">Email</div>
              <div class="matrix-col">In-app</div>
              <div class="matrix-col">Push</div>
            </div>
            <div class="notif-row">
              <div class="notif-row-label">New tickets</div>
              <label class="check"><input type="checkbox" data-notif="newTicket" data-chan="email" checked><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="newTicket" data-chan="inapp" checked><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="newTicket" data-chan="push" checked><span
                  class="check-box"></span></label>
            </div>
            <div class="notif-row">
              <div class="notif-row-label">Replies & mentions</div>
              <label class="check"><input type="checkbox" data-notif="reply" data-chan="email" checked><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="reply" data-chan="inapp" checked><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="reply" data-chan="push"><span
                  class="check-box"></span></label>
            </div>
            <div class="notif-row">
              <div class="notif-row-label">Crash reports</div>
              <label class="check"><input type="checkbox" data-notif="crash" data-chan="email" checked><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="crash" data-chan="inapp" checked><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="crash" data-chan="push" checked><span
                  class="check-box"></span></label>
            </div>
            <div class="notif-row">
              <div class="notif-row-label">Weekly digest</div>
              <label class="check"><input type="checkbox" data-notif="digest" data-chan="email" checked><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="digest" data-chan="inapp"><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="digest" data-chan="push"><span
                  class="check-box"></span></label>
            </div>
            <div class="notif-row">
              <div class="notif-row-label">Product updates</div>
              <label class="check"><input type="checkbox" data-notif="product" data-chan="email"><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="product" data-chan="inapp" checked><span
                  class="check-box"></span></label>
              <label class="check"><input type="checkbox" data-notif="product" data-chan="push"><span
                  class="check-box"></span></label>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <h3>Quiet Hours</h3>
              <div class="card-sub">Pause non-urgent notifications during these hours</div>
            </div>
            <label class="switch">
              <input type="checkbox" id="quiet-hours-toggle" checked>
              <span class="switch-slider"></span>
            </label>
          </div>
          <div class="quiet-hours">
            <div class="time-input">
              <label>From</label>
              <input type="time" id="quiet-from" value="22:00" />
            </div>
            <div class="time-arrow"><i data-lucide="arrow-right"></i></div>
            <div class="time-input">
              <label>To</label>
              <input type="time" id="quiet-to" value="08:00" />
            </div>
            <div class="time-input">
              <label>Timezone</label>
              <select id="quiet-tz">
                <option>Local time</option>
                <option>UTC</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== ACTIVITY TAB ===== -->
      <div class="account-pane" data-account-pane="activity" hidden>
        <div class="grid-2">
          <div class="card">
            <div class="card-head">
              <h3>This week</h3>
            </div>
            <div class="mini-stats">
              <div class="mini-stat">
                <div class="mini-stat-icon" style="background:var(--gradient)"><i data-lucide="ticket"></i></div>
                <div>
                  <div class="mini-stat-value" id="week-handled">0</div>
                  <div class="mini-stat-label">Tickets handled</div>
                </div>
              </div>
              <div class="mini-stat">
                <div class="mini-stat-icon" style="background:linear-gradient(135deg,#10b981,#059669)"><i
                    data-lucide="check"></i></div>
                <div>
                  <div class="mini-stat-value" id="week-resolved">0</div>
                  <div class="mini-stat-label">Resolved</div>
                </div>
              </div>
              <div class="mini-stat">
                <div class="mini-stat-icon" style="background:linear-gradient(135deg,#06b6d4,#6366f1)"><i
                    data-lucide="message-square"></i></div>
                <div>
                  <div class="mini-stat-value" id="week-replies">0</div>
                  <div class="mini-stat-label">Replies sent</div>
                </div>
              </div>
              <div class="mini-stat">
                <div class="mini-stat-icon" style="background:linear-gradient(135deg,#f59e0b,#ef4444)"><i
                    data-lucide="zap"></i></div>
                <div>
                  <div class="mini-stat-value" id="week-avg">—</div>
                  <div class="mini-stat-label">Avg. response</div>
                </div>
              </div>
            </div>
          </div>
          <div class="card">
            <div class="card-head">
              <h3>Activity</h3>
            </div>
            <div class="chart-wrap" style="min-height:200px">
              <canvas id="chart-my-activity"></canvas>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-head">
            <div>
              <h3>Recent Actions</h3>
              <div class="card-sub">Your latest activity on the dashboard</div>
            </div>
          </div>
          <div class="activity-feed" id="my-activity-feed">
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
          </div>
        </div>
      </div>

      <!-- ===== INTEGRATIONS TAB ===== -->
      <div class="account-pane" data-account-pane="integrations" hidden>
        <div class="card">
          <div class="card-head">
            <div>
              <h3>Connected Apps</h3>
              <div class="card-sub">Supercharge your workflow with third-party tools</div>
            </div>
          </div>
          <div class="integrations-grid">
            <div class="integration-card" data-integration="slack">
              <div class="integration-head">
                <div class="integration-icon" style="background:linear-gradient(135deg,#4a154b,#ecb22e)">
                  <i data-lucide="message-circle"></i>
                </div>
                <label class="switch">
                  <input type="checkbox" data-integration-toggle="slack">
                  <span class="switch-slider"></span>
                </label>
              </div>
              <div class="integration-name">Slack</div>
              <div class="integration-desc">Get notified in your Slack channels when new tickets arrive.</div>
              <div class="integration-status">Not connected</div>
            </div>
            <div class="integration-card" data-integration="discord">
              <div class="integration-head">
                <div class="integration-icon" style="background:linear-gradient(135deg,#5865f2,#404eed)">
                  <i data-lucide="hash"></i>
                </div>
                <label class="switch">
                  <input type="checkbox" data-integration-toggle="discord">
                  <span class="switch-slider"></span>
                </label>
              </div>
              <div class="integration-name">Discord</div>
              <div class="integration-desc">Forward ticket updates to your Discord server via webhook.</div>
              <div class="integration-status">Not connected</div>
            </div>
            <div class="integration-card" data-integration="github">
              <div class="integration-head">
                <div class="integration-icon" style="background:linear-gradient(135deg,#333,#000)">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path
                      d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                </div>
                <label class="switch">
                  <input type="checkbox" data-integration-toggle="github">
                  <span class="switch-slider"></span>
                </label>
              </div>
              <div class="integration-name">GitHub</div>
              <div class="integration-desc">Link crash reports to GitHub issues automatically.</div>
              <div class="integration-status">Not connected</div>
            </div>
            <div class="integration-card" data-integration="zapier">
              <div class="integration-head">
                <div class="integration-icon" style="background:linear-gradient(135deg,#ff4a00,#fc6a00)">
                  <i data-lucide="zap"></i>
                </div>
                <label class="switch">
                  <input type="checkbox" data-integration-toggle="zapier">
                  <span class="switch-slider"></span>
                </label>
              </div>
              <div class="integration-name">Zapier</div>
              <div class="integration-desc">Connect to 5,000+ apps without writing a line of code.</div>
              <div class="integration-status">Not connected</div>
            </div>
            <div class="integration-card" data-integration="webhook">
              <div class="integration-head">
                <div class="integration-icon" style="background:var(--gradient)">
                  <i data-lucide="webhook"></i>
                </div>
                <label class="switch">
                  <input type="checkbox" data-integration-toggle="webhook">
                  <span class="switch-slider"></span>
                </label>
              </div>
              <div class="integration-name">Custom Webhook</div>
              <div class="integration-desc">POST events to any URL you control.</div>
              <div class="integration-status">Not connected</div>
            </div>
            <div class="integration-card" data-integration="telegram">
              <div class="integration-head">
                <div class="integration-icon" style="background:linear-gradient(135deg,#229ed9,#0088cc)">
                  <i data-lucide="send"></i>
                </div>
                <label class="switch">
                  <input type="checkbox" data-integration-toggle="telegram">
                  <span class="switch-slider"></span>
                </label>
              </div>
              <div class="integration-name">Telegram</div>
              <div class="integration-desc">Get instant push notifications in Telegram.</div>
              <div class="integration-status">Not connected</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== DANGER ZONE ===== -->
      <div class="account-pane" data-account-pane="danger" hidden>
        <div class="card danger-zone">
          <div class="card-head">
            <div>
              <h3>Sign out everywhere</h3>
              <div class="card-sub">End all active sessions on every device</div>
            </div>
          </div>
          <p class="muted">This will sign you out of all devices except this one. You'll need to sign in again on each
            device.</p>
          <button class="btn-danger" id="btn-danger-signout-all">
            <i data-lucide="log-out"></i><span>Sign out of all devices</span>
          </button>
        </div>

        <div class="card danger-zone">
          <div class="card-head">
            <div>
              <h3>Reset dashboard preferences</h3>
              <div class="card-sub">Clear all local preferences, theme, compact mode, etc.</div>
            </div>
          </div>
          <p class="muted">Your account data will not be affected. This only resets your local UI preferences.</p>
          <button class="btn-danger" id="btn-danger-reset">
            <i data-lucide="refresh-ccw"></i><span>Reset preferences</span>
          </button>
        </div>

        <div class="card danger-zone critical">
          <div class="card-head">
            <div>
              <h3>Delete account</h3>
              <div class="card-sub">Permanently remove your admin account and all data</div>
            </div>
            <span class="critical-badge">
              <i data-lucide="alert-triangle"></i> Irreversible
            </span>
          </div>
          <p class="muted">This action cannot be undone. All your data, preferences, and access will be permanently
            removed.</p>
          <div class="form-field">
            <label>Type <strong>DELETE</strong> to confirm</label>
            <input type="text" id="delete-confirm" placeholder="DELETE" />
          </div>
          <button class="btn-critical" id="btn-danger-delete" disabled>
            <i data-lucide="trash-2"></i><span>Delete my account forever</span>
          </button>
        </div>
      </div>
    </div>
  </div>
  </div>

  <!-- ===== SETTINGS ===== -->
  <div class="route" data-route="settings" hidden>
    <div class="card">
      <div class="card-head">
        <h3>Profile</h3>
      </div>
      <div class="profile-row">
        <div class="admin-avatar xl" id="settings-avatar">A</div>
        <div>
          <div class="admin-name lg" id="settings-name">Admin</div>
          <div class="muted" id="settings-email">—</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h3>Preferences</h3>
      </div>
      <div class="settings-grid">
        <div class="setting">
          <div>
            <div class="setting-name">Theme</div>
            <div class="setting-desc">Light or dark appearance</div>
          </div>
          <div class="seg" id="theme-seg">
            <button class="seg-btn" data-theme="light"><i data-lucide="sun"></i> Light</button>
            <button class="seg-btn active" data-theme="dark"><i data-lucide="moon"></i> Dark</button>
          </div>
        </div>
        <div class="setting">
          <div>
            <div class="setting-name">Compact mode</div>
            <div class="setting-desc">Reduce spacing in tables</div>
          </div>
          <label class="switch">
            <input type="checkbox" id="compact-mode">
            <span class="switch-slider"></span>
          </label>
        </div>
        <div class="setting">
          <div>
            <div class="setting-name">Animations</div>
            <div class="setting-desc">Enable micro-interactions</div>
          </div>
          <label class="switch">
            <input type="checkbox" id="anim-toggle" checked>
            <span class="switch-slider"></span>
          </label>
        </div>
      </div>
    </div>

    <div class="card danger-zone">
      <div class="card-head">
        <h3>Session</h3>
      </div>
      <p class="muted">Sign out of this admin account on this device.</p>
      <button class="btn-danger" id="btn-logout-2">
        <i data-lucide="log-out"></i>
        <span>Sign out</span>
      </button>
    </div>
  </div>
  </section>
  </main>
  </div>

  <!-- ============ TICKET DETAIL MODAL ============ -->
  <div class="modal" id="ticket-modal" hidden>
    <div class="modal-backdrop" data-close></div>
    <div class="modal-body">
      <div class="modal-head">
        <div>
          <div class="modal-eyebrow">
            <i data-lucide="ticket"></i>
            <span>Ticket</span>
            <span class="status-pill sm" id="modal-status-pill">—</span>
          </div>
          <h3 id="modal-subject">—</h3>
        </div>
        <button class="icon-btn" data-close aria-label="Close">
          <i data-lucide="x"></i>
        </button>
      </div>

      <div class="modal-meta">
        <div class="meta-item">
          <div class="meta-label">From</div>
          <div class="meta-value" id="modal-email">—</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Created</div>
          <div class="meta-value" id="modal-time">—</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">User ID</div>
          <div class="meta-value mono" id="modal-userid">—</div>
        </div>
      </div>

      <div class="modal-message-wrap">
        <div class="chat-history" id="modal-chat-history">
          <div class="muted center pad" style="flex:1;display:flex;align-items:center;justify-content:center;">Loading
            conversation...</div>
        </div>
      </div>

      <div class="modal-section">
        <div class="meta-label">Update status</div>
        <div class="status-actions">
          <button class="status-btn" data-status="open">
            <span class="dot dot-open"></span> Open
          </button>
          <button class="status-btn" data-status="in_progress">
            <span class="dot dot-progress"></span> In Progress
          </button>
          <button class="status-btn" data-status="resolved">
            <span class="dot dot-resolved"></span> Resolved
          </button>
        </div>
      </div>

      <div class="modal-section">
        <div class="reply-head">
          <div class="meta-label">Reply to user</div>
          <div class="muted sm">Sent to <span id="reply-target">—</span></div>
        </div>
        <textarea id="modal-reply" placeholder="Write a clear, helpful reply..."></textarea>
        <div class="reply-actions">
          <button class="btn-ghost" id="btn-reply-template">
            <i data-lucide="sparkles"></i> Use template
          </button>
          <button class="btn-primary" id="btn-send-reply">
            <i data-lucide="send"></i>
            <span>Send reply</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ USER DETAIL MODAL ============ -->
  <div class="modal" id="user-modal" hidden>
    <div class="modal-backdrop" data-close-user></div>
    <div class="modal-body" style="max-width:800px;">
      <div class="modal-head">
        <div>
          <div class="modal-eyebrow">
            <i data-lucide="user"></i>
            <span>User Details</span>
            <span class="status-pill sm" id="modal-user-status-pill">—</span>
          </div>
          <h3 id="modal-user-name">—</h3>
        </div>
        <button class="icon-btn" data-close-user aria-label="Close">
          <i data-lucide="x"></i>
        </button>
      </div>

      <div class="modal-meta" style="margin-bottom: 24px;">
        <div class="meta-item">
          <div class="meta-label">Email</div>
          <div class="meta-value" id="modal-user-email">—</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Created</div>
          <div class="meta-value" id="modal-user-created">—</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Last Seen</div>
          <div class="meta-value" id="modal-user-lastseen">—</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">User ID</div>
          <div class="meta-value mono" id="modal-user-id">—</div>
        </div>
      </div>

      <div class="grid-2" style="gap:24px;">
        <div class="modal-section" style="background:var(--surface-hover); padding:16px; border-radius:12px;">
          <div class="meta-label">User Statistics</div>
          <div style="display:flex; flex-direction:column; gap:12px; margin-top:12px;">
            <div style="display:flex; justify-content:space-between;">
              <span class="muted">Total Tickets</span>
              <strong id="modal-user-tickets-count">0</strong>
            </div>
            <div style="display:flex; justify-content:space-between;">
              <span class="muted">Crash Reports</span>
              <strong id="modal-user-crashes-count">0</strong>
            </div>
            <div style="display:flex; justify-content:space-between;">
              <span class="muted">App Version</span>
              <strong id="modal-user-version">—</strong>
            </div>
          </div>
        </div>

        <div class="modal-section" style="background:var(--surface-hover); padding:16px; border-radius:12px;">
          <div class="meta-label">Admin Actions</div>
          <div style="display:flex; flex-direction:column; gap:12px; margin-top:12px;">
            <button class="btn btn-sm" id="btn-user-enable"
              style="justify-content:flex-start; background:rgba(16,185,129,0.1); color:#10b981;">
              <i data-lucide="check-circle"></i> Enable User
            </button>
            <button class="btn btn-sm" id="btn-user-disable"
              style="justify-content:flex-start; background:rgba(245,158,11,0.1); color:#f59e0b;">
              <i data-lucide="slash"></i> Disable / Ban User
            </button>
            <button class="btn btn-sm" id="btn-user-delete"
              style="justify-content:flex-start; background:rgba(239,68,68,0.1); color:#ef4444;">
              <i data-lucide="trash-2"></i> Delete User Data
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ CRASH MODAL ============ -->
  <div class="modal" id="crash-modal" hidden>
    <div class="modal-backdrop" data-close-crash></div>
    <div class="modal-body" style="max-width:860px;">
      <div class="modal-head">
        <div>
          <div class="modal-eyebrow"><i data-lucide="bug"></i><span>Crash report</span></div>
          <h3 id="crash-modal-title">—</h3>
        </div>
        <button class="icon-btn" data-close-crash aria-label="Close"><i data-lucide="x"></i></button>
      </div>
      <div class="modal-meta">
        <div class="meta-item">
          <div class="meta-label">Time</div>
          <div class="meta-value" id="crash-modal-time">—</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Device</div>
          <div class="meta-value" id="crash-modal-device">—</div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Domain</div>
          <div class="meta-value mono" id="crash-modal-domain">—</div>
        </div>
      </div>
      <div class="modal-section">
        <div class="meta-label">Message</div>
        <pre id="crash-modal-message"
          style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:180px;overflow:auto;margin:8px 0 0;"></pre>
      </div>
      <div class="modal-section">
        <div class="meta-label">Stack trace</div>
        <pre id="crash-modal-stack"
          style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow:auto;margin:8px 0 0;"></pre>
      </div>
      <div class="modal-section">
        <div class="meta-label">Context</div>
        <pre id="crash-modal-context"
          style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:160px;overflow:auto;margin:8px 0 0;"></pre>
      </div>
      <div class="reply-actions"><button class="btn-ghost" id="btn-copy-crash"><i data-lucide="copy"></i> Copy full
          report</button></div>
    </div>
  </div>

  <!-- ============ NOTIFICATIONS DRAWER ============ -->
  <div class="drawer" id="notif-drawer" hidden>
    <div class="drawer-backdrop" data-close-drawer></div>
    <div class="drawer-body">
      <div class="drawer-head">
        <h3>Notifications</h3>
        <button class="icon-btn" data-close-drawer aria-label="Close">
          <i data-lucide="x"></i>
        </button>
      </div>
      <div id="notif-list" class="notif-list">
        <div class="muted center pad">No new notifications</div>
      </div>
    </div>
  </div>

  <!-- ============ TOASTS ============ -->
  <div id="toast-root" class="toast-root" aria-live="polite" aria-atomic="true"></div>

  <script type="module" src="app.js"></script>
</body>

</html>