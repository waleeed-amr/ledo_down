# Ensure consistent line endings across platforms
* text=auto

# Force binary for media, archives, executables, and binary blobs
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.jar binary
*.apk binary
*.aab binary
*.ipa binary
*.db binary
*.sqlite binary
*.mp4 binary
*.mp3 binary
*.wav binary
