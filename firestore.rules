rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin writes are intentionally protected by a Firebase Auth custom
    // claim.  Do not weaken this to "any signed-in user"; the public
    // dashboard can otherwise publish malicious installer links.
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'waleed@ledodown.local');
    }

    // Helper: any authenticated user
    function isAuth() {
      return request.auth != null;
    }

    // Helper: owner of the document
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      // Admin can read and update user profiles (e.g. status, ban)
      allow read, update: if isAdmin();

      // User account subcollection (profile, notifications, preferences, etc.)
      match /account/{document=**} {
        allow read, write: if isOwner(userId);
        // Admin can read (for audit purposes)
        allow read: if isAdmin();
      }

      // Activity log
      match /activity_log/{logId} {
        allow read, write: if isOwner(userId);
        allow read: if isAdmin();
      }

      // Sessions management
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
        allow read, write: if isAdmin();
      }

      // API tokens
      match /tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // Messages sent by admin to users
      match /messages/{messageId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isAdmin();
      }
    }

    // Crash reports: anyone can create (incl. anonymous)
    // Only admin can read/delete them.
    match /crash_reports/{reportId} {
      allow create: if request.resource.data.keys().hasAll(['message', 'createdAt']) && request.resource.data.message is string;
      allow read, delete: if isAdmin();
    }

    // Remote announcements: public read for desktop app users, admin can write
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App config (e.g. latest_update): public read for version checks, admin can write
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Releases
    match /app_releases/{releaseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Activity Log
    match /admin_activity/{activityId} {
      allow read, write: if isAdmin();
    }

    // Admin Notifications
    match /admin_notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // Telemetry and Update Events from devices
    match /telemetry/{deviceId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }
    match /update_events/{eventId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // Heartbeats: anonymous app startup pings
    match /heartbeats/{heartbeatId} {
      allow create: if request.resource.data.keys().hasAll(['message', 'createdAt']);
      allow read, delete: if isAdmin();
    }

    // Support tickets / Chats
    match /chats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      
      match /messages/{messageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
      }
    }
  }
}
