rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Crash reports: anyone can create (including anonymous users)
    // Only the admin can read/delete them.
    match /crash_reports/{reportId} {
      allow create: if true;
      allow read, delete: if request.auth != null && request.auth.token.email == 'admin@ledodown.local';
    }
  }
}
